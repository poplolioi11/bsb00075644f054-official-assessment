          "columns": [
            {
              "text": "前者浙藩司德方伯詣"
            },
            {
              "text": "文廟拈香有已革候補知縣陳某徘徊門左錢塘"
            },
            {
              "text": "縣程邑尊見其形跡可疑命役盤詰搜出"
            },
            {
              "text": "洋鎗一桿小刀一柄程邑尊帶至杭府請"
            },
            {
              "text": "示方伯亦於是刻聞信面稟撫憲即飭讞"
            },
            {
              "text": "局訊問該革員狀似瘋癲聲稱被參"
            },
            {
              "text": "後家累甚重不能囘里頃間欲稟明"
            },
            {
              "text": "上憲倘或不准願自斃於階"
            },
            {
              "text": "下云々局員據情上稟刻"
            },
            {
              "text": "下聞已批准祗作瘋子辦"
            },
            {
              "text": "理想大憲有好生之德瘋"
            },
            {
              "text": "員亦當有悔罪之忱矣"
            }
          ],
